DATABASE_URL=postgresql://user:password@localhost:5432/asanaClone
PORT=4002
CORS_ORIGIN=http://localhost:5173

# Public URL of the frontend. Used to build links in emails and OAuth redirects.
APP_URL=http://localhost:5173

# Secret used to sign auth session JWTs. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=

# Secret used to sign the session and refresh-token cookies. Generate one with:
#   openssl rand -hex 32
COOKIE_SECRET=

# How long an access token / refresh token stays valid.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Mail sending — tries SMTP first, then Resend, then logs the email to the
# console if neither is configured (or both fail). Leave everything below
# blank in dev if you're fine reading links from the console log.
#
# SMTP (e.g. Gmail): set SMTP_USER to your Gmail address and SMTP_PASS to an
# App Password (not your normal password) — myaccount.google.com/apppasswords,
# requires 2-Step Verification enabled first. Delivers to any recipient.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Resend API key — resend.com/api-keys. Free tier without a verified domain
# can only deliver to the email address your Resend account itself uses.
RESEND_API_KEY=
# Sender shown on outgoing mail. Defaults to SMTP_USER when set.
MAIL_FROM=Clearing <onboarding@resend.dev>

# Google OAuth app credentials (Google Cloud Console > APIs & Services >
# Credentials > OAuth client ID > Web application). Leave blank to disable
# "Sign in with Google" — the button will render but the flow will fail at
# Google until these are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4002/api/auth/google/callback
